# Base URL of the gaadi.pk backend REST API (include the /api prefix).
# Copy this file to ".env" to override the default (http://localhost:5000/api).
VITE_API_URL=http://localhost:5000/api

# Socket.IO origin for booking chat. Leave blank to use the origin of
# VITE_API_URL (e.g. http://localhost:5000). Set only if the Socket.IO server
# lives somewhere else. If VITE_API_URL is relative (/api), the page origin is
# used and nginx must proxy /socket.io/ to the backend.
VITE_SOCKET_URL=
