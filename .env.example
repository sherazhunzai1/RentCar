# Base URL of the gaadi.pk backend REST API (include the /api prefix).
# Copy this file to ".env" to override the default (http://localhost:5000/api).
VITE_API_URL=http://localhost:5000/api

# Base URL of the Socket.IO server for booking chat. MUST be VITE_-prefixed and
# the app REBUILT after changing it (Vite bakes env vars in at build time).
# Set this when the Socket.IO server is on a different host than the REST API,
# e.g. VITE_SOCKETS_URL=https://socket.gaadi.pk
# Leave blank to use the origin of VITE_API_URL.
VITE_SOCKETS_URL=
# (VITE_SOCKET_URL is also accepted as an alias.)
