# gaadi.pk per-trip OG renderer — systemd unit
#
# Install:
#   sudo cp deploy/og-renderer.service /etc/systemd/system/gaadi-og.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gaadi-og
#   systemctl status gaadi-og
#   journalctl -u gaadi-og -f        # logs
#
# Adjust WorkingDirectory / User / ports / API_URL to match your server.
[Unit]
Description=gaadi.pk per-trip OG renderer
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/gaadi.pk
ExecStart=/usr/bin/node server/og-server.mjs
Restart=on-failure
RestartSec=2
User=www-data
Group=www-data

# Configuration
Environment=OG_HOST=127.0.0.1
Environment=OG_PORT=8082
Environment=API_URL=http://127.0.0.1:5000/api
Environment=SITE_URL=https://gaadi.pk

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
